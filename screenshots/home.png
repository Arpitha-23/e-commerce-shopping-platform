    <title>Home - E-Commerce Store</title>

    <link href="./home_files/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .hero {
            padding: 70px 20px;
            background: #212529;
            color: white;
            border-radius: 15px;
        }

        .product-card {
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            height: 220px;
            object-fit: cover;
        }

        footer {
            margin-top: 60px;
            padding: 25px;
            background: #212529;
            color: white;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="http://127.0.0.1:8000/">
