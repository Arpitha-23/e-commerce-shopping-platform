    <div class="app-auth module">
      <table>
        <caption>
          <a href="http://127.0.0.1:8000/admin/auth/" class="section" title="Models in the Authentication and Authorization application">Authentication and Authorization</a>
        </caption>
        <thead class="visually-hidden">
          <tr>
            <th scope="col">Model name</th>
            <th scope="col">Add link</th>
            <th scope="col">Change or view list link</th>
          </tr>
        </thead>
        
          
            <tbody><tr class="model-group">
              <th scope="row" id="auth-group">
                
                  <a href="http://127.0.0.1:8000/admin/auth/group/">Groups</a>
                
              </th>

              
                <td><a href="http://127.0.0.1:8000/admin/auth/group/add/" class="addlink" aria-describedby="auth-group">Add</a></td>
              

              
                
                  <td><a href="http://127.0.0.1:8000/admin/auth/group/" class="changelink" aria-describedby="auth-group">Change</a></td>
                
              
            </tr>
          
        
          
            <tr class="model-user">
              <th scope="row" id="auth-user">
                
                  <a href="http://127.0.0.1:8000/admin/auth/user/">Users</a>
                
              </th>

              
                <td><a href="http://127.0.0.1:8000/admin/auth/user/add/" class="addlink" aria-describedby="auth-user">Add</a></td>
              

              
                
                  <td><a href="http://127.0.0.1:8000/admin/auth/user/" class="changelink" aria-describedby="auth-user">Change</a></td>
                
              
            </tr>
          
        
      </tbody></table>
    </div>
  
