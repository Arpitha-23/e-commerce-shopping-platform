<!DOCTYPE html>
<!-- saved from url=(0031)http://127.0.0.1:8000/wishlist/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Wishlist - E-Commerce Store</title>

    <link href="./wishlist_files/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .hero {
            padding: 70px 20px;
            background: #212529;
            color: white;
            border-radius: 15px;
        }

        .product-card {
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            height: 220px;
            object-fit: cover;
        }

        footer {
            margin-top: 60px;
            padding: 25px;
            background: #212529;
            color: white;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="http://127.0.0.1:8000/">
            🛒 E-Commerce Store
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto">

                <!-- Home -->
                <li class="nav-item">
                    <a class="nav-link" href="http://127.0.0.1:8000/">
                        Home
                    </a>
                </li>

                <!-- Products -->
                <li class="nav-item">
                    <a class="nav-link" href="http://127.0.0.1:8000/#products">
                        Products
                    </a>
                </li>

                <!-- Cart -->
                <li class="nav-item">
                    <a class="nav-link" href="http://127.0.0.1:8000/cart/">
                        🛒 Cart
                    </a>
                </li>


                

                    <!-- My Orders -->
                    <li class="nav-item">
                        <a class="nav-link" href="http://127.0.0.1:8000/orders/">
                            📦 My Orders
                        </a>
                    </li>
                    
                    <!-- Wishlist -->
                    <li class="nav-item">
                          <a class="nav-link" href="http://127.0.0.1:8000/wishlist/">
                           ❤️ Wishlist
                         </a>
                    </li>

                    <!-- Username -->
                    <li class="nav-item">
                        <span class="nav-link">
                            👤 customer1
                        </span>
                    </li>

                    <!-- Logout -->
                    <li class="nav-item">
                        <a class="nav-link" href="http://127.0.0.1:8000/logout/">
                            Logout
                        </a>
                    </li>

                


                <!-- Admin -->
                <li class="nav-item">
                    <a class="nav-link" href="http://127.0.0.1:8000/admin/">
                        Admin
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>


<main class="container py-4">

    

<h1 class="mb-4">❤️ My Wishlist</h1>



<div class="row">

    

    <div class="col-md-4 mb-4">

        <div class="card h-100 shadow-sm">

            
                <img src="./wishlist_files/headphones_gGO17Xf.jpg" class="card-img-top product-image" alt="Wireless Headphones">
            

            <div class="card-body">

                <h5 class="card-title">
                    Wireless Headphones
                </h5>

                <p class="text-muted">
                    Electronics
                </p>

                <h5 class="text-success">
                    ₹1999.00
                </h5>

                <a href="http://127.0.0.1:8000/product/1/" class="btn btn-dark">
                    View Product
                </a>

                <a href="http://127.0.0.1:8000/wishlist/remove/1/" class="btn btn-outline-danger">
                    Remove
                </a>

            </div>

        </div>

    </div>

    

    <div class="col-md-4 mb-4">

        <div class="card h-100 shadow-sm">

            
                <img src="./wishlist_files/tshirt_LrzrUzQ.jpg" class="card-img-top product-image" alt="T-Shirt">
            

            <div class="card-body">

                <h5 class="card-title">
                    T-Shirt
                </h5>

                <p class="text-muted">
                    Clothing
                </p>

                <h5 class="text-success">
                    ₹799.00
                </h5>

                <a href="http://127.0.0.1:8000/product/3/" class="btn btn-dark">
                    View Product
                </a>

                <a href="http://127.0.0.1:8000/wishlist/remove/3/" class="btn btn-outline-danger">
                    Remove
                </a>

            </div>

        </div>

    </div>

    

</div>





</main>


<footer class="text-center">

    <p class="mb-0">
        © 2026 E-Commerce Store | Django Full Stack Project
    </p>

</footer>


<script src="./wishlist_files/bootstrap.bundle.min.js.download">
</script>


</body></html>