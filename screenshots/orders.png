    <title>My Orders - E-Commerce Store</title>

    <link href="./orders_files/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .hero {
            padding: 70px 20px;
            background: #212529;
            color: white;
            border-radius: 15px;
        }

        .product-card {
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-image {
            height: 220px;
            object-fit: cover;
        }

        footer {
            margin-top: 60px;
            padding: 25px;
            background: #212529;
            color: white;
        }
    </style>
</head>

<body>

